{
  "name": "prestige-crm",
  "version": "2.0.0",
  "description": "Prestige CRM Desktop Application",
  "main": "electron-main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build:frontend": "webpack --mode production",
    "build": "npm run build:frontend",
    "electron": "electron .",
    "electron:build": "electron-builder",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.4.0",
    "@salesforce-ux/design-system": "^2.30.4",
    "antd": "^6.4.4",
    "axios": "^1.6.0",
    "bcrypt": "^5.1.1",
    "better-sqlite3": "^11.10.0",
    "chart.js": "^4.5.1",
    "cors": "^2.8.5",
    "electron-updater": "^6.8.9",
    "express": "^4.21.0",
    "joi": "^18.2.3",
    "jsonwebtoken": "^9.0.0",
    "multer": "^1.4.5-lts.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.80.0",
    "react-router-dom": "^6.20.0",
    "typescript": "^6.0.3",
    "winston": "^3.19.0",
    "yup": "^1.7.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.0.0",
    "@babel/preset-env": "^7.0.0",
    "@babel/preset-react": "^7.0.0",
    "@babel/preset-typescript": "^7.26.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "babel-loader": "^9.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^5.0.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "html-webpack-plugin": "^5.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "style-loader": "^3.0.0",
    "webpack": "^5.0.0",
    "webpack-cli": "^5.0.0",
    "webpack-dev-server": "^5.2.5"
  },
  "author": "Prestige Solutions Pte Ltd",
  "build": {
    "appId": "com.prestige.crm",
    "productName": "Prestige CRM",
    "asar": true,
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "public/assets/icon.ico",
      "artifactName": "${productName}_Setup_${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Prestige CRM",
      "installerIcon": "public/assets/icon.ico",
      "uninstallerIcon": "public/assets/icon.ico",
      "installerHeaderIcon": "public/assets/icon.ico",
      "license": "LICENSE",
      "include": "installer.nsi"
    },
    "files": [
      "electron-main.js",
      "electron-preload.js",
      "server.js",
      "server/**/*",
      "services/**/*",
      "database/**/*",
      "dist/**/*",
      "public/**/*",
      "node_modules/**/*",
      "!.env"
    ]
  }
}
